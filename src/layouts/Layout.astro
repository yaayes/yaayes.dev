---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  canonicalURL?: string;
}

const {
  title,
  description = "A technical blog about software development and DevOps",
  ogImage,
  type = "website",
  publishedTime,
  modifiedTime,
  author,
  tags,
  canonicalURL,
} = Astro.props;

const siteURL = Astro.site ?? new URL("https://yaayes.dev");
const pageURL = canonicalURL ?? new URL(Astro.url.pathname, siteURL).href;
const siteName = "yaayes.dev";
const twitterHandle = "@yaayes";

// Full page title: "Article Title — yaayes.dev" or just "yaayes.dev" for homepage
const isHome = Astro.url.pathname === "/";
const fullTitle = isHome ? siteName : `${title} — ${siteName}`;

// OG image: use provided, else fallback to default social card
const ogImageURL = ogImage
  ? new URL(ogImage, siteURL).href
  : new URL("/og/default.png", siteURL).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageURL} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />

    <!-- Article-specific OG -->
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}
    {tags && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Per-page head slot (e.g. JSON-LD from BlogPost) -->
    <slot name="head" />

    <!-- Dark mode script - runs before body to prevent flash -->
    <script is:inline>
      function initTheme() {
        const stored = localStorage.getItem("theme") || "system";
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;

        let shouldBeDark = false;
        if (stored === "system") {
          shouldBeDark = prefersDark;
        } else {
          shouldBeDark = stored === "dark";
        }

        if (shouldBeDark) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      }
      initTheme();
    </script>
  </head>
  <body>
    <slot />

    <!-- Theme toggle functionality -->
    <script>
      function applyTheme(theme: string) {
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        let shouldBeDark = false;

        if (theme === "system") {
          shouldBeDark = prefersDark;
        } else {
          shouldBeDark = theme === "dark";
        }

        if (shouldBeDark) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }

        localStorage.setItem("theme", theme);

        // Dispatch event for UI updates
        window.dispatchEvent(new CustomEvent("themechange", { detail: theme }));
      }

      function setTheme(theme: string) {
        applyTheme(theme);
      }

      // Expose function globally
      (window as any).setTheme = setTheme;

      // Listen for system theme changes
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", (e) => {
          const stored = localStorage.getItem("theme") || "system";
          if (stored === "system") {
            if (e.matches) {
              document.documentElement.classList.add("dark");
            } else {
              document.documentElement.classList.remove("dark");
            }
          }
        });
    </script>
  </body>
</html>
