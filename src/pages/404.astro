---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout
  title="404 - Page Not Found"
  description="The page you're looking for doesn't exist"
>
  <div data-pagefind-ignore>
    <Header />

    <main class="max-w-3xl mx-auto px-4 py-24 text-center">
      <p
        class="font-mono text-sm mb-6"
        style="color: rgb(var(--color-primary)); opacity: 0.7;"
      >
        $ cat /dev/null
      </p>

      <h1 class="text-6xl font-extrabold mb-6" style="letter-spacing: -0.04em;">
        404
      </h1>

      <p
        class="text-xl mb-3 leading-relaxed"
        style="color: rgb(var(--color-text)); opacity: 0.75;"
      >
        Looks like this page took a wrong turn at the last deployment.
      </p>
      <p
        class="text-base mb-10 leading-relaxed"
        style="color: rgb(var(--color-text)); opacity: 0.55;"
      >
        Either it never existed, or it's been deprecated like that old code we
        all pretend doesn't exist.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
        <a href="/" class="btn">← Go Home</a>
        <a href="/blog" class="btn-outline">Browse Articles</a>
      </div>

      <div
        class="mt-16 p-5 rounded-lg border border-[rgb(var(--color-border))] text-left"
      >
        <p
          class="font-mono text-xs"
          style="color: rgb(var(--color-text)); opacity: 0.5;"
        >
          <span style="color: rgb(var(--color-primary));">pro tip:</span> check the
          URL for typos, or <a
            href="/contact"
            class="underline"
            style="color: rgb(var(--color-primary));">let me know</a
          > if you think this page should exist.
        </p>
      </div>
    </main>
  </div>
</Layout>
