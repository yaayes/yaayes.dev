---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))];

  return allTags.map((tag) => ({
    params: { tag },
  }));
}

const { tag } = Astro.params;

const allPosts = (await getCollection("posts"))
  .filter((post) => !post.data.draft && post.data.tags.includes(tag))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout
  title={`Posts tagged with "${tag}"`}
  description={`All articles about ${tag}`}
>
  <div data-pagefind-ignore>
    <Header />

    <main class="max-w-5xl mx-auto px-4 py-16">
      <div class="mb-12">
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 text-sm font-mono mb-6 transition-colors"
          style="color: rgb(var(--color-text)); opacity: 0.45;"
          onmouseover="this.style.opacity='1'; this.style.color='rgb(var(--color-primary))';"
          onmouseout="this.style.opacity='0.45'; this.style.color='rgb(var(--color-text))';"
        >
          ← cd ..
        </a>
        <p
          class="font-mono text-sm mb-3"
          style="color: rgb(var(--color-primary)); opacity: 0.7;"
        >
          $ grep -r "{tag}" ~/posts
        </p>
        <h1
          class="text-4xl md:text-5xl font-extrabold mb-3"
          style="letter-spacing: -0.03em;"
        >
          <span style="color: rgb(var(--color-primary));">{tag}</span>
        </h1>
        <p
          class="font-mono text-xs"
          style="color: rgb(var(--color-text)); opacity: 0.42;"
        >
          {allPosts.length}
          {allPosts.length === 1 ? "result" : "results"} found
        </p>
      </div>

      <!-- Posts list — editorial style -->
      <div>
        {
          allPosts.length > 0 ? (
            allPosts.map((post) => (
              <article class="post-item group">
                <a href={`/blog/${post.slug}`} class="block">
                  <h2 class="text-xl font-bold mb-2 leading-snug group-hover:text-[rgb(var(--color-primary))] transition-colors">
                    {post.data.title}
                  </h2>
                  <p
                    class="text-sm mb-3 leading-relaxed"
                    style="color: rgb(var(--color-text)); opacity: 0.62;"
                  >
                    {post.data.description}
                  </p>
                  <div class="flex flex-wrap items-center gap-3">
                    <time
                      datetime={post.data.pubDate.toISOString()}
                      class="font-mono text-xs"
                      style="color: rgb(var(--color-text)); opacity: 0.42;"
                    >
                      {post.data.pubDate.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                      })}
                    </time>
                    {post.data.tags.length > 0 && (
                      <div class="flex gap-1.5 flex-wrap">
                        {post.data.tags.map((t) => (
                          <a
                            href={`/blog/tag/${t}`}
                            class={t === tag ? "tag-active" : "tag"}
                          >
                            {t}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              </article>
            ))
          ) : (
            <p
              class="py-8 font-mono text-sm"
              style="color: rgb(var(--color-text)); opacity: 0.5;"
            >
              // No posts found for this tag.
            </p>
          )
        }
      </div>
    </main>
  </div>
</Layout>
