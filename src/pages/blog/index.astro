---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Search from "../../components/Search.astro";
import { getCollection } from "astro:content";
import { getReadingTime } from "../../utils/reading-time";

const allPosts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Get search query from URL
const searchQuery = Astro.url.searchParams.get("q") || "";

// Get unique tags
const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort();
---

<Layout
  title="Blog"
  description="All articles about software development and DevOps"
>
  <Header />

  <main class="max-w-5xl mx-auto px-4 py-16">
    <div class="mb-12">
      <p
        class="font-mono text-sm mb-3"
        style="color: rgb(var(--color-primary)); opacity: 0.7;"
      >
        $ ls ~/posts
      </p>
      <h1
        class="text-4xl md:text-5xl font-extrabold"
        style="letter-spacing: -0.03em;"
      >
        All Articles
      </h1>
    </div>

    <!-- Search -->
    <Search searchQuery={searchQuery} />

    <!-- Tags Filter -->
    {
      allTags.length > 0 && (
        <div class="mb-12">
          <p
            class="text-xs font-mono mb-3"
            style="color: rgb(var(--color-text)); opacity: 0.45;"
          >
            filter by tag:
          </p>
          <div class="flex flex-wrap gap-2">
            <a href="/blog" class="tag-active">
              all
            </a>
            {allTags.map((tag) => (
              <a href={`/blog/tag/${tag}`} class="tag">
                {tag}
              </a>
            ))}
          </div>
        </div>
      )
    }

    <!-- Posts list — editorial style -->
    <div>
      {
        allPosts.length > 0 ? (
          allPosts.map((post) => (
            <article class="post-item group">
              <a href={`/blog/${post.slug}`} class="block">
                <h2 class="text-xl font-bold mb-2 leading-snug group-hover:text-[rgb(var(--color-primary))] transition-colors">
                  {post.data.title}
                </h2>
                <p
                  class="text-sm mb-3 leading-relaxed"
                  style="color: rgb(var(--color-text)); opacity: 0.62;"
                >
                  {post.data.description}
                </p>
                <div class="flex flex-wrap items-center gap-3">
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="font-mono text-xs"
                    style="color: rgb(var(--color-text)); opacity: 0.42;"
                  >
                    {post.data.pubDate.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </time>
                  <span class="font-mono text-xs" style="color: rgb(var(--color-text)); opacity: 0.42;">
                    · {getReadingTime(post.body ?? "")}
                  </span>
                  {post.data.tags.length > 0 && (
                    <div class="flex gap-1.5 flex-wrap">
                      {post.data.tags.map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            </article>
          ))
        ) : (
          <p
            class="py-8 font-mono text-sm"
            style="color: rgb(var(--color-text)); opacity: 0.5;"
          >
            // No posts yet. Check back soon!
          </p>
        )
      }
    </div>
  </main>
</Layout>
